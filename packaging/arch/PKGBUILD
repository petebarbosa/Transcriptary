# Maintainer: petebarbosa <https://github.com/petebarbosa>
pkgname=transcriptary
pkgver=0.3.6
pkgrel=1
pkgdesc='Record and transcribe your meetings locally, with speaker separation'
arch=('x86_64')
url='https://github.com/petebarbosa/Transcriptary'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libpulse' 'libayatana-appindicator' 'glib2' 'dbus' 'glibc' 'gcc-libs' 'hicolor-icon-theme')
makedepends=('cargo' 'nodejs' 'npm' 'git')
optdepends=('xdg-utils: open links and folders from the app')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8fafd03943bf07722051ae3a55abdf64e3ae2c6cb86f64fe09b2c4ec1f899231')

prepare() {
  cd "Transcriptary-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci --no-audit --no-fund
}

build() {
  cd "Transcriptary-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Frontend is built by tauri's beforeBuildCommand; no AppImage here, just the binary.
  npx tauri build --no-bundle -- --locked
}

package() {
  cd "Transcriptary-$pkgver"
  install -Dm755 target/release/tary "$pkgdir/usr/bin/tary"
  install -Dm644 packaging/linux/transcriptary.desktop \
    "$pkgdir/usr/share/applications/transcriptary.desktop"

  local size
  for size in 32 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/transcriptary.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/transcriptary.png"
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/transcriptary.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
